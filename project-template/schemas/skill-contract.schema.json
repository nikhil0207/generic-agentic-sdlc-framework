{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-agentic-sdlc.invalid/schemas/skill-contract.schema.json",
  "title": "Governed Skill Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "purpose", "applicability", "location", "owner_agent", "invoking_agent_allowlist", "lifecycle_phases", "inputs", "outputs", "evidence_requirements", "allowed_operations", "prohibited_operations", "authority_inheritance", "approval_behavior", "provider_dependencies", "framework_compatibility", "metadata_reconciliation", "integrity_metadata", "lifecycle_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "applicability": {"type": "string", "minLength": 1},
    "location": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)[^\\s]+$"},
    "owner_agent": {"type": "string", "pattern": "^(00|05|10|15|17|20|30|40|50|60|70|80|90|100)-[a-z0-9-]+$"},
    "invoking_agent_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(00|05|10|15|17|20|30|40|50|60|70|80|90|100)-[a-z0-9-]+$"}},
    "lifecycle_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ROUTE", "DISCOVERY", "REQUIREMENTS", "ARCHITECTURE", "DEVELOPMENT", "REVIEW", "TEST", "AUTOMATION", "DOCUMENTATION"]}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FACT", "INFERENCE", "ASSUMPTION", "UNKNOWN", "RECOMMENDATION", "PROJECT_DECLARED_EVIDENCE", "CODE_INTELLIGENCE_EVIDENCE"]}},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read", "search", "edit", "execute"]}},
    "prohibited_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["approve", "route", "merge", "deploy", "database_remediation", "security_remediation", "workflow_state_change", "silent_handoff", "status_coercion"]}},
    "authority_inheritance": {"const": "INTERSECTION_REQUIRED"},
    "approval_behavior": {"enum": ["HUMAN_OR_ORCHESTRATOR_GATE_ONLY"]},
    "provider_dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "required"], "properties": {"id": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}}},
    "framework_compatibility": {"type": "string", "minLength": 1},
    "metadata_reconciliation": {"type": "object", "additionalProperties": false, "required": ["source", "front_matter_required", "conflict_status"], "properties": {"source": {"const": "registry"}, "front_matter_required": {"type": "boolean"}, "conflict_status": {"const": "REWORK_REQUIRED"}}},
    "integrity_metadata": {"type": "object", "additionalProperties": false, "required": ["hash_algorithm", "content_hash"], "properties": {"hash_algorithm": {"const": "SHA-256"}, "content_hash": {"type": "string", "minLength": 1}}},
    "lifecycle_status": {"enum": ["ACTIVE", "PLANNED", "DEPRECATED", "DISABLED", "EXPERIMENTAL"]}
  }
}
