{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://generic-agentic-sdlc.invalid/schemas/evidence.schema.json",
	"title": "Evidence and Provenance Contract",
	"type": "object",
	"additionalProperties": false,
	"required": ["evidence_id", "producing_agent", "workflow_id", "created_at", "verification_status"],
	"properties": {
		"evidence_id": {"type": "string", "minLength": 1},
		"producing_agent": {"type": "string", "pattern": "^(00|05|10|15|17|20|30|40|50|60|70|80|90|100)-[a-z0-9-]+$"},
		"workflow_id": {"type": "string", "minLength": 1},
		"created_at": {"type": "string", "minLength": 1},
		"verification_status": {"enum": ["VERIFIED", "UNVERIFIED", "FAILED"]},
		"classification": {"enum": ["REPOSITORY_EVIDENCE", "HUMAN_SUPPLIED_EVIDENCE", "PROJECT_DECLARED_EVIDENCE", "INDEPENDENTLY_VERIFIED_EVIDENCE", "HISTORICAL_EVIDENCE", "GENERATED_ARTIFACT_EVIDENCE", "CODE_INTELLIGENCE_EVIDENCE", "DERIVED_CONTEXT"]},
		"source_type": {"type": "string", "minLength": 1},
		"source_access_status": {"enum": ["AVAILABLE", "UNAVAILABLE", "PARTIAL", "UNKNOWN"]},
		"source_path": {"type": "string", "minLength": 1},
		"source_reference": {"type": "string", "minLength": 1},
		"source_commit": {"type": ["string", "null"]},
		"source_file_reference": {"type": "string", "minLength": 1},
		"verification_date": {"type": "string", "minLength": 1},
		"checked_at": {"type": "string", "minLength": 1},
		"confidence": {"type": "number", "minimum": 0, "maximum": 1},
		"provenance": {"type": "object", "additionalProperties": false, "properties": {"provider_id": {"type": "string"}, "provider_version": {"type": "string"}, "provider_mode": {"enum": ["DISABLED", "SHADOW", "ENABLED"]}, "query_timestamp": {"type": "string"}, "index_timestamp": {"type": "string"}, "source_branch": {"type": "string"}}},
		"reconciliation_status": {"enum": ["NOT_REQUIRED", "PENDING", "RESOLVED", "FAILED"]},
		"conflict_id": {"type": "string"},
		"provider_id": {"type": "string"},
		"provider_version": {"type": "string"},
		"provider_mode": {"enum": ["DISABLED", "SHADOW", "ENABLED"]},
		"graphify_query_timestamp": {"type": "string"},
		"graphify_index_timestamp": {"type": "string"},
		"corroboration_status": {"enum": ["NOT_REQUIRED", "PENDING", "CORROBORATED", "DISAGREEMENT", "UNVERIFIED"]},
		"evidence_authority": {"enum": ["AUTHORITATIVE", "SUPPLEMENTAL_ONLY", "NONE"]},
		"protected_evidence": {"type": "boolean"},
		"immutable_raw_reference": {"type": "string"},
		"raw_hash_algorithm": {"const": "SHA-256"},
		"raw_hash": {"type": "string"},
		"headroom_original_context_reference": {"type": "string"},
		"headroom_original_context_hash": {"type": "string"},
		"sha256": {"type": ["string", "null"]},
		"work_item_id": {"type": "string"},
		"lifecycle_assessment_date": {"type": "string"}
	},
	"allOf": [
		{"if": {"properties": {"classification": {"const": "CODE_INTELLIGENCE_EVIDENCE"}}}, "then": {"properties": {"evidence_authority": {"const": "SUPPLEMENTAL_ONLY"}, "corroboration_status": {"const": "CORROBORATED"}}, "required": ["provider_id", "provider_version", "corroboration_status"]}},
		{"if": {"properties": {"classification": {"const": "DERIVED_CONTEXT"}}}, "then": {"properties": {"evidence_authority": {"const": "NONE"}}}},
		{"if": {"properties": {"protected_evidence": {"const": true}}}, "then": {"required": ["immutable_raw_reference", "raw_hash_algorithm", "raw_hash"]}}
	]
}
