{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-agentic-sdlc.invalid/schemas/authority-denial.schema.json",
  "title": "Authority Denial Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["denial_id", "timestamp", "work_item_id", "workflow_id", "requesting_agent_id", "requested_skill_or_provider", "requested_action", "effective_agent_authority", "skill_or_provider_authority", "project_policy", "lifecycle_phase", "approval_state", "denial_reason", "fallback", "resulting_status", "evidence_references", "required_human_approval"],
  "properties": {
    "denial_id": {"type": "string", "pattern": "^DEN-[A-Za-z0-9-]+$"},
    "timestamp": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "requesting_agent_id": {"type": "string", "pattern": "^(00|05|10|15|17|20|30|40|50|60|70|80|90|100)-[a-z0-9-]+$"},
    "requested_skill_or_provider": {"type": "string", "minLength": 1},
    "requested_action": {"type": "string", "minLength": 1},
    "effective_agent_authority": {"type": "array", "items": {"type": "string"}},
    "skill_or_provider_authority": {"type": "array", "items": {"type": "string"}},
    "project_policy": {"type": "string", "minLength": 1},
    "lifecycle_phase": {"enum": ["ROUTE", "DISCOVERY", "REQUIREMENTS", "ARCHITECTURE", "DEVELOPMENT", "REVIEW", "TEST", "AUTOMATION", "DOCUMENTATION"]},
    "approval_state": {"type": "string", "minLength": 1},
    "denial_reason": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1},
    "resulting_status": {"enum": ["BLOCKED", "REWORK_REQUIRED", "FAILED"]},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "required_human_approval": {"type": "boolean"},
    "provenance": {"type": "object"},
    "recommended_next_action": {"type": "string"}
  }
}
